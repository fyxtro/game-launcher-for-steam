{
  "name": "game-launcher-for-steam",
  "version": "1.2.0",
  "private": true,
  "description": "Stream Deck plugin: launch your Steam games from an auto-filled grid",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart tools.quin.steamlibrary\"",
    "link": "streamdeck link tools.quin.steamlibrary.sdPlugin",
    "pack": "node tools/build-profiles.mjs && rollup -c && streamdeck pack tools.quin.steamlibrary.sdPlugin -o dist --force",
    "profiles": "node tools/build-profiles.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3",
    "@elgato/utils": "^0.6.1",
    "jimp": "^1.6.1"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.19.2",
    "adm-zip": "^0.6.1",
    "rollup": "^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "5.9"
  }
}
